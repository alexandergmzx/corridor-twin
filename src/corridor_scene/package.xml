<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>corridor_scene</name>
  <version>0.1.0</version>
  <description>GPU-independent OpenUSD scene authoring and validation for corridor-twin.</description>
  <maintainer email="alexandergmzx@gmail.com">Alexander Gomez</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>python3-yaml</exec_depend>
  <!-- scene.build imports cv2 unconditionally through scene/marker_assets.py
       (ArUco marker image generation) and numpy through the same chain. Both
       were previously satisfied only by the system-site-packages venv leaking
       apt's python3-opencv; ADR 0025 declares them instead. The
       occlusion/certificate chain deliberately needs neither. -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
